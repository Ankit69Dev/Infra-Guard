generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER")

  reports  Report[]
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InfrastructureAsset {
  id           String    @id @default(cuid())
  assetCode    String    @unique
  name         String
  type         AssetType
  description  String?
  locationName String?
  city         String?
  district     String?
  state        String?
  latitude     Float
  longitude    Float
  status       String?

  installationDate        DateTime?
  installationYear        Int?
  expectedMaintenanceYear Int?
  currentYear             Int?

  ageYears       Float?
  conditionScore Float?
  riskScore      Float?
  riskLevel      RiskLevel?
  totalReports   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports            Report[]
  riskAnalyses       RiskAnalysis[]
  maintenanceRecords MaintenanceRecord[]
  officialProjects   OfficialProject[]

  @@index([type])
  @@index([latitude, longitude])
  @@index([riskScore])
  @@index([riskLevel])
}

model Report {
  id          String    @id @default(cuid())
  reportCode  String    @unique
  title       String
  description String
  type        AssetType

  status     ReportStatus @default(OPEN)
  source     ReportSource @default(CITIZEN)
  department String

  latitude  Float
  longitude Float
  address   String?
  imageUrl  String?

  installationYear        Int?
  expectedMaintenanceYear Int?
  currentYear             Int?

  assetId String?
  userId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset        InfrastructureAsset? @relation(fields: [assetId], references: [id])
  user         User?                @relation(fields: [userId], references: [id])
  riskAnalyses RiskAnalysis[]

  @@index([assetId])
  @@index([type])
  @@index([department])
  @@index([status])
  @@index([createdAt])
}

model RiskAnalysis {
  id       String  @id @default(cuid())
  assetId  String
  reportId String?

  riskScore Float
  riskLevel RiskLevel

  explanation String?
  model       String?

  analyzedAt DateTime @default(now())

  asset  InfrastructureAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  report Report?             @relation(fields: [reportId], references: [id])

  @@index([assetId])
  @@index([reportId])
  @@index([riskScore])
}

model MaintenanceRecord {
  id String @id @default(cuid())

  assetId String
  asset   InfrastructureAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  maintenanceType String
  description     String?

  performedAt DateTime
  completedAt DateTime?

  status String?

  contractor String?
  cost       Float?

  source    String?
  sourceUrl String?

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([performedAt])
}

model OfficialProject {
  id String @id @default(cuid())

  projectCode String
  title       String

  assetType AssetType @default(ROAD)

  projectDate DateTime?

  amount          Float?
  agreementAmount Float?

  physicalProgress  Float?
  financialProgress Float?

  scheduledDate DateTime?

  contractor String?

  department String?
  source     String?
  sourceUrl  String?

  matchedAssetId String?
  matchedAsset   InfrastructureAsset? @relation(fields: [matchedAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectCode, title])
  @@index([assetType])
  @@index([projectDate])
  @@index([matchedAssetId])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AssetType {
  ROAD
  BRIDGE
  DRAINAGE
  STREETLIGHT
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportSource {
  CITIZEN
  DEPARTMENT
  INSPECTION
  SYSTEM
}
model ReportDeletion {
  id         String   @id @default(cuid())
  reportCode String
  title      String
  reason     String
  deletedAt  DateTime @default(now())
  deletedBy  String?

  @@index([reportCode])
  @@index([deletedAt])
}